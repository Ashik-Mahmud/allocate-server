generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  photo              String?
  personal_credits   Int?                @default(0)
  role               Role                @default(ORG_ADMIN)
  last_login         DateTime?
  deletedAt          DateTime?
  createdAt          DateTime?           @default(now())
  updatedAt          DateTime?           @updatedAt
  org_id             String?
  is_verified        Boolean?            @default(false)
  token_expiry       DateTime?
  verification_token String?             @unique
  createdBookings    Bookings[]          @relation("BookingCreator")
  bookings           Bookings[]          @relation("BookingUser")
  creditTransactions CreditTransaction[]
  notifications      Notification[]
  organization       Organizations?      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  activityLogs       ActivityLog[]
  communityHubs      CommunityHub[]

  @@index([email, org_id])
  @@map("users")
}

model Organizations {
  id                  String              @id @default(cuid())
  name                String
  org_type            String?
  tagline             String?
  photo               String?
  plan_type           PlanType?           @default(FREE)
  credit_pool         Int?                @default(100)
  is_active           Boolean?            @default(true)
  deletedAt           DateTime?
  createdAt           DateTime?           @default(now())
  updatedAt           DateTime?           @updatedAt
  address             Json?
  business_email      String?
  slug                String?             @unique
  timezone            String              @default("UTC")
  needUpdateOrg       Boolean?            @default(true)
  isVerified          Boolean?            @default(false)
  settings            Json?               @default("{\"notificationPreference\": {\"sms\": false, \"push\": false, \"email\": true, \"inApp\": true}}")
  frozen_credits      Int?                @default(0)
  weeklyReportEnabled Boolean?            @default(false)
  hasUsedTrial        Boolean             @default(false)
  isTrialAllowed      Boolean             @default(true)
  trialEndsAt         DateTime?
  trialStartAt        DateTime?
  bookings            Bookings[]
  communityHubs       CommunityHub[]
  creditTransactions  CreditTransaction[]
  invitations         Invitation[]
  notifications       Notification[]
  resources           Resources[]
  resourcesRules      ResourcesRule[]
  salesInquiries      SalesInquiry[]
  subscription        Subscription?
  users               User[]
  activityLogs        ActivityLog[]

  @@index([name, id])
  @@map("organizations")
}

model Resources {
  id               String         @id @default(cuid())
  org_id           String
  name             String
  type             String
  metadata         Json
  is_available     Boolean        @default(true)
  is_active        Boolean        @default(true)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  hourly_rate      Decimal
  is_maintenance   Boolean        @default(false)
  photo            String?
  currentBookingId String?        @unique
  is_occupied      Boolean        @default(false)
  isAutoConfirm    Boolean        @default(false)
  bookings         Bookings[]     @relation("AllResourceBookings")
  currentBooking   Bookings?      @relation("CurrentResourceBooking", fields: [currentBookingId], references: [id])
  organization     Organizations  @relation(fields: [org_id], references: [id])
  resourcesRules   ResourcesRule?

  @@index([org_id])
  @@map("resources")
}

model ResourcesRule {
  id                 String        @id @default(cuid())
  org_id             String
  resource_id        String        @unique
  max_booking_hours  Float?
  min_lead_time      Float?
  buffer_time        Float?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  availableDays      Json?         @default("[]")
  closing_hours      Int?          @default(18)
  is_weekend_allowed Boolean       @default(false)
  opening_hours      Int?          @default(9)
  slot_duration_min  Int           @default(30)
  organization       Organizations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  resource           Resources     @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@index([org_id, resource_id])
  @@map("resources_rules")
}

model Subscription {
  id                  String           @id @default(cuid())
  org_id              String           @unique
  plan_name           PlanType
  start_date          DateTime
  end_date            DateTime?
  payment_status      PaymentStatus?
  is_active           Boolean?         @default(true)
  deletedAt           DateTime?
  createdAt           DateTime?        @default(now())
  updatedAt           DateTime?        @updatedAt
  last_reminder_sent  DateTime?
  external_id         String?          @unique
  last_transaction_id String?
  provider            PaymentProvider?
  organization        Organizations    @relation(fields: [org_id], references: [id])

  @@index([org_id])
  @@map("subscriptions")
}

model Bookings {
  id                  String              @id @default(cuid())
  user_id             String
  resource_id         String
  org_id              String
  start_time          DateTime
  end_time            DateTime
  total_cost          Int?                @default(0)
  cancellation_reason String?
  deletedAt           DateTime?
  createdAt           DateTime?           @default(now())
  updatedAt           DateTime?           @updatedAt
  status              BookingStatus?      @default(PENDING)
  created_by          String?
  metadata            Json?
  notes               String?
  creator             User?               @relation("BookingCreator", fields: [created_by], references: [id])
  organization        Organizations       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  resource            Resources           @relation("AllResourceBookings", fields: [resource_id], references: [id], onDelete: Cascade)
  user                User                @relation("BookingUser", fields: [user_id], references: [id], onDelete: Cascade)
  creditTransactions  CreditTransaction[]
  currentOfResource   Resources?          @relation("CurrentResourceBooking")

  @@index([user_id, resource_id, org_id, status])
  @@map("bookings")
}

model CreditTransaction {
  id              String          @id @default(uuid())
  org_id          String
  user_id         String
  amount          Float           @default(0)
  type            TransactionType
  previousBalance Float           @default(0)
  currentBalance  Float           @default(0)
  referenceId     String?
  description     String?
  performedBy     String?
  createdAt       DateTime        @default(now())
  price_paid      Float?          @default(0)
  currency        String?
  payment_gateway String?
  status          String?
  transaction_id  String?
  metadata        Json?
  organization    Organizations   @relation(fields: [org_id], references: [id], onDelete: Cascade)
  booking         Bookings?       @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([org_id, user_id])
  @@map("credit_transactions")
}

model Notification {
  id           String           @id @default(cuid())
  user_id      String
  org_id       String
  type         NotificationType
  title        String
  message      String
  is_read      Boolean          @default(false)
  reference_id String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  metadata     Json?
  organization Organizations    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, org_id, is_read])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  org_id    String?
  user_id   String
  action    String
  ipAddress String
  userAgent String
  metadata  Json?
  createdAt DateTime @default(now())
  details   String?

  organization Organizations? @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([org_id, user_id])
  @@map("activity_logs")
}

model SystemSettings {
  id                   String   @id @default("default")
  maintenance_mode     Boolean  @default(false)
  global_alert_message Json?
  support_email        String?
  features_flags       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("system_settings")
}

model Invitation {
  id           String           @id @default(cuid())
  org_id       String
  email        String
  role         Role             @default(ORG_ADMIN)
  token        String           @unique
  expiresAt    DateTime
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  organization Organizations    @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id, email])
  @@map("invitations")
}

model SalesInquiry {
  id             String            @id @default(cuid())
  org_id         String?
  name           String
  business_email String
  phone          String?
  message        String
  team_size      String?
  country        String?
  status         SaleInquiryStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organizations?    @relation(fields: [org_id], references: [id])

  @@map("sales_inquiries")
  @@index([org_id, business_email, status])
}

model CommunityHub {
  id              String               @id @default(cuid())
  org_id          String?
  title           String
  content         String
  imageUrl        String?
  authorId        String?
  authorName      String?
  authorRole      Role?
  comments        Json?
  acknowledgments Json?
  status          CommunityHubStatus   @default(DRAFT)
  postType        CommunityHubPostType @default(GENERAL_DISCUSSION)
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  isPrivate       Boolean              @default(false)
  visibility      Json?                @default("{\"showToAdmin\": true, \"showToStaff\": true, \"showToOrgAdmin\": true}")
  organization    Organizations?       @relation(fields: [org_id], references: [id])
  author          User?                @relation(fields: [authorId], references: [id])

  @@map("community_hub")
  @@index([org_id, authorId, status, postType])
}

enum CommunityHubPostType {
  ANNOUNCEMENT
  RESOURCE_SPOTLIGHT
  USER_STORY
  EVENT
  ISSUES
  RESOLVED
  GENERAL_DISCUSSION
  OTHER
  SYSTEM_QUERY
}

enum CommunityHubStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum SaleInquiryStatus {
  PENDING
  CONTACTED
  CLOSED
  CONVERTED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  CHECKED_IN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  CREDIT_RECEIVED
  SYSTEM_ALERT
  INVITATION_RECEIVED
  BOOKING_REMINDER
  CREDIT_REVOKED
  LOW_CREDIT_WARNING
  STAFF_JOINED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  MAINTENANCE_NOTICE
  BOOKING_REQUESTED
  BOOKING_CANCELLED
  RESOURCE_MAINTENANCE
  RESOURCE_AVAILABLE
  BOOKING_COMPLETED
  UPGRADE_PLAN_REMINDER
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELLED
  CREDIT_RESET
  BOOKING_CHECKED_IN
  WEEKLY_REPORT
  BOOKING_RESCHEDULED
  CONTACT_SALES
  TRIAL_ACTIVATED
  TRIAL_EXPIRING
  TRIAL_EXPIRED
  CREATE_COMMUNITY_POST
  PUBLISHED_COMMUNITY_POST
}

enum TransactionType {
  SPEND
  ALLOCATE
  REFUND
  REVOKE
  TOP_UP
  DEDUCT
  ADJUSTMENT
  FREE_ALLOCATION
}

enum Role {
  STAFF
  ADMIN
  ORG_ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  OVERDUE
  TRIAL
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
  TRIAL
}
